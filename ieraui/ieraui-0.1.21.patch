diff --git a/forge-ai/src/main/java/forge/ai/AiEvaluation.java b/forge-ai/src/main/java/forge/ai/AiEvaluation.java
new file mode 100644
index 0000000000..882da8cea6
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/AiEvaluation.java
@@ -0,0 +1,57 @@
+package forge.ai;
+
+import java.util.concurrent.TimeUnit;
+import forge.util.AITimeoutTracker;
+import java.util.function.Supplier;
+
+/** Cooperative, same-thread AI decisions. Never leave a worker mutating a live game. */
+public final class AiEvaluation {
+    private static final ThreadLocal<Long> DEADLINE = new ThreadLocal<>();
+
+    private AiEvaluation() { }
+
+    public static <T> T run(long timeoutMillis, Supplier<T> decision, T fallback) {
+        Long previous = DEADLINE.get();
+        long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(Math.max(0, timeoutMillis));
+        DEADLINE.set(previous == null ? deadline : Math.min(previous, deadline));
+        final Object upstreamLimit = AITimeoutTracker.arm(DEADLINE.get(), false);
+        try {
+            check();
+            return decision.get();
+        } catch (Expired | AITimeoutTracker.Expired expired) {
+            // Nested decisions must unwind to the outer decision's fallback.
+            if (previous != null) {
+                throw expired;
+            }
+            AiCache.clear();
+            return fallback;
+        } catch (RuntimeException failed) {
+            // Preserve the previous evaluator's error reporting and safe pass.
+            if (previous != null) {
+                throw failed;
+            }
+            failed.printStackTrace();
+            AiCache.clear();
+            return fallback;
+        } finally {
+            AITimeoutTracker.disarm(upstreamLimit);
+            if (previous == null) {
+                DEADLINE.remove();
+            } else {
+                DEADLINE.set(previous);
+            }
+        }
+    }
+
+    public static void check() {
+        Long deadline = DEADLINE.get();
+        if (deadline != null && (Thread.currentThread().isInterrupted() || System.nanoTime() - deadline >= 0)) {
+            throw new Expired();
+        }
+    }
+
+    private static final class Expired extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+        private Expired() { super(null, null, false, false); }
+    }
+}
